#!/bin/bash
ip route add default via 10.42.0.1 dev usb0 2>/dev/null || true
echo 0 > /proc/sys/net/core/bpf_jit_enable 2>/dev/null || true

# The "we are in kexec" status light is started earlier, from the initramfs
# (quest-kexec/initramfs/qkx-led.sh), so it is already blinking by the time
# this runs -- see steamos-stage1-desktop/README.md.

/usr/local/bin/de_service.sh > /tmp/de_service.log 2>&1 &
